# /etc/profile - run by every login shell, before the user's own.
#
# The machine's settings go here; a person's go in ~/.profile, which is
# read after this and so can override anything set here.
#
# This is not bash's file. /bin/sh on this machine is kernel/shell.c
# built as a program, and it understands a command list (; && ||),
# pipelines, redirection and variables. bash reads THIS file too when it
# is the login shell -- every login shell reads /etc/profile -- and then
# ~/.bash_profile (which the shipped one sources ~/.bashrc from). What
# bash does NOT read at login is ~/.bashrc directly; that is for the
# interactive shells you start afterwards.

export PATH=/bin:/usr/bin:.
export PAGER=less
export EDITOR=em

# The prompt shows the working directory, which is what `cd` is for.
export PS1='\w$ '

# Set here so ~/.profile can use it without command substitution,
# which this shell has not got.
export HOSTNAME=sage040
