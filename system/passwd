# /etc/passwd - who this machine knows about.
#
# name:password:uid:gid:description:home:shell
#
# The password field is 'x', meaning "the hash is in /etc/shadow". It
# is not the hash itself: this file has to be world-readable, because
# every getpwnam() reads it to turn a uid into a name, and a hash
# everybody can read is a hash everybody can attack offline.
#
# The shell and the home directory are not decoration. login(1) chdir's
# to the home directory and exec's the shell named here, so a wrong
# entry is a user who cannot log in.
root:x:0:0:root:/root:/bin/sh
jfrancis:x:1000:1000:Jeff Francis:/home/jfrancis:/bin/sh
