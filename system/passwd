# /etc/passwd - who this machine knows about.
#
# name:password:uid:gid:description:home:shell
#
# The password field is empty and means nothing yet: there is nothing
# on this system that asks for one, because there is nothing to log
# in to. When ssh arrives it will need real hashes, and they belong in
# /etc/shadow rather than here -- this file is world-readable by
# definition, and on a FAT volume everything is world-readable whether
# it is by definition or not.
#
# ENFORCEMENT IS NOT HERE EITHER. A process has a real user id now
# (kernel/task.h), inherited across fork and exec and changed by
# setuid, and getpwnam() will find these entries. What no user id can
# do yet is stop anybody reading anybody's files, because a FAT
# directory entry has nowhere to record an owner. That waits for a
# filesystem that can hold one.
root::0:0:root:/root:/bin/sh
jfrancis::1000:1000:Jeff Francis:/home/jfrancis:/bin/sh
