# SuckOS default /etc/rc
#
# What the machine does before it hands you a prompt. Run by the shell
# at startup (kernel/shell.c): one command per line, and no conditionals
# beyond the shell's ; && || -- anything needing more belongs in a
# program.
#
# THE LINE ABOVE IS A MARKER. `make programs` replaces this file while
# it still says "SuckOS default", and leaves it alone the moment you
# change that line -- so an unedited default keeps up with the system
# and a configuration you wrote is yours. `make etc` replaces it either
# way.

# The kernel's messages, into /var/log/syslog. klogd sleeps until the
# kernel says something, so it costs nothing to leave running.
klogd -q &

# The time zone: Denver. The clock keeps UTC, as a machine's clock
# should, and TZ is how a program turns that into a local time -- a
# POSIX TZ string carries its own daylight-saving rules, which is why
# there is no zoneinfo database here to keep up to date.
#
#   MST7MDT      mountain standard time, seven hours behind UTC,
#                mountain daylight time when it applies
#   M3.2.0       from the second Sunday in March
#   M11.1.0      to the first Sunday in November
#
# (Both at 02:00 local, which is the default when no time is given.)
export TZ=MST7MDT,M3.2.0,M11.1.0

# WHOSE MACHINE THIS IS -- nothing, any more, and that is the point.
#
# HOME used to be set here, because the machine booted straight into a
# root shell and there was nothing to log in to. There is now: the
# console asks who you are, /bin/login checks the password, and it sets
# HOME, SHELL, USER and LOGNAME from that person's line in /etc/passwd
# before it execs their shell. Setting HOME here would override the
# answer for whoever logs in, which is the opposite of what it was for.
#
# /etc/rc runs BEFORE the login prompt and as root. Put machine-wide
# policy here; put a person's settings in their own ~/.profile, which
# their login shell reads.

# The network. DHCP by default -- the machine comes up with an address
# on any LAN that hands one out, which is what a machine on a network is
# expected to do. For a fixed address instead, replace this with
# `ifconfig <ip> <mask> [gateway]`. (`ifconfig nvram` would read net=dhcp
# or net.ip/net.mask/net.gw from /bin/nvram, but this board's NVRAM does
# not survive a power cycle, so the line written here is the one that
# sticks.) A boot with no network at all falls through in a few seconds:
# DHCP gives up after three tries and the prompt appears anyway.
ifconfig dhcp
