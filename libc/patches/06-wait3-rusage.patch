picolibc 1.8.12: libos/linux/wait3.c hands the kernel a buffer laid out
as picolibc's own struct rusage and copies it back as though the kernel
had filled it that way. picolibc's timevals have a 64-bit time_t; the
kernel's rusage timevals are longs. On a 32-bit machine every time it
returns is therefore garbage. Now the kernel's layout is declared as
it is -- longs, which is right on every Linux -- and converted.
Not specific to m68k.

--- a/libos/linux/wait3.c	2026-09-22 08:26:04.658837782 -0600
+++ b/libos/linux/wait3.c	2026-09-22 08:26:04.675569257 -0600
@@ -35,6 +35,7 @@
 
 #include "local-sigaction.h"
 #include <sys/wait.h>
+#include <string.h>
 
 pid_t
 wait3(int *wstatus, int options, struct rusage *rusage)
@@ -42,9 +43,11 @@
     int   koptions = 0;
     pid_t ret;
     int   kstatus;
+    /* The kernel's layout: its timevals are longs, not time_t. */
     struct {
-        struct rusage usage;
-        long          space[16];
+        long utime_sec, utime_usec;
+        long stime_sec, stime_usec;
+        long other[14];
     } kusage, *pusage = NULL;
 
     if (options & WNOHANG)
@@ -62,8 +65,13 @@
         else if (WIFSTOPPED(kstatus))
             kstatus = __W_EXITCODE(_signal_from_linux(WSTOPSIG(kstatus)), 0x7f);
         *wstatus = kstatus;
-        if (rusage)
-            *rusage = kusage.usage;
+        if (rusage) {
+            memset(rusage, 0, sizeof(*rusage));
+            rusage->ru_utime.tv_sec = kusage.utime_sec;
+            rusage->ru_utime.tv_usec = kusage.utime_usec;
+            rusage->ru_stime.tv_sec = kusage.stime_sec;
+            rusage->ru_stime.tv_usec = kusage.stime_usec;
+        }
     }
     return ret;
 }
