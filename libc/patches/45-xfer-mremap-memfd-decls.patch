Declarations for calls the m68k backend now has (libos/linux/machine/
m68k/xfer.c): mremap and memfd_create in <sys/mman.h>, splice in
<fcntl.h> and copy_file_range in <unistd.h>, all under _GNU_SOURCE as
glibc has them, with Linux's flag values.

--- a/libc/include/sys/mman.h	2026-09-29 19:49:59.176389607 -0600
+++ b/libc/include/sys/mman.h	2026-09-29 19:49:59.191731133 -0600
@@ -150,6 +150,14 @@
 int   shm_unlink(const char *name);
 #if __GNU_VISIBLE
 int madvise(void *addr, size_t len, int advice);
+
+/* Linux's: a mapping resized or moved, and a file with no name. */
+#define MREMAP_MAYMOVE    1
+#define MREMAP_FIXED      2
+#define MFD_CLOEXEC       0x0001U
+#define MFD_ALLOW_SEALING 0x0002U
+void *mremap(void *old, size_t old_len, size_t new_len, int flags, ...);
+int   memfd_create(const char *name, unsigned int flags);
 #endif
 
 _END_STD_C
--- a/libc/include/sys/_default_fcntl.h	2026-09-29 19:49:59.176437477 -0600
+++ b/libc/include/sys/_default_fcntl.h	2026-09-29 19:49:59.191810105 -0600
@@ -216,6 +216,15 @@
 #if __BSD_VISIBLE
 extern int flock(int, int);
 #endif
+#if __GNU_VISIBLE
+/* Linux's: bytes to or from a pipe, with no buffer in the program.
+ * off_t is 64 bits here, which is exactly Linux's loff_t. */
+#define SPLICE_F_MOVE     1
+#define SPLICE_F_NONBLOCK 2
+#define SPLICE_F_MORE     4
+#define SPLICE_F_GIFT     8
+extern __ssize_t splice(int, off_t *, int, off_t *, __size_t, unsigned int);
+#endif
 
 /* Provide _<systemcall> prototypes for functions provided by some versions
    of newlib.  */
--- a/libc/include/sys/unistd.h	2026-09-29 19:49:59.176488011 -0600
+++ b/libc/include/sys/unistd.h	2026-09-29 19:49:59.191937272 -0600
@@ -632,6 +632,11 @@
 #define _CS_POSIX_V7_THREADS_LDFLAGS       19
 #define _CS_V7_ENV                         20
 #define _CS_V6_ENV                         _CS_V7_ENV
+
+#if __GNU_VISIBLE
+ssize_t copy_file_range(int __in, off_t *__off_in, int __out,
+                        off_t *__off_out, size_t __len, unsigned int __flags);
+#endif
 #define _CS_LFS_CFLAGS                     21
 #define _CS_LFS_LDFLAGS                    22
 #define _CS_LFS_LIBS                       23
