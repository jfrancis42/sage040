picolibc 1.8.12, libos/linux: an SA_SIGINFO handler got Linux's signal
number in si_signo while its first argument was picolibc's -- 12 and 31
for SIGUSR2. Found by libc/test/libctest. Not specific to m68k.

--- a/libos/linux/sigaction.c
+++ b/libos/linux/sigaction.c
@@ -87,6 +87,9 @@
 #endif
     SIMPLE_MAP_SIGINFO(&info, kinfo);
     SIMPLE_MAP_SIGVAL(&info.si_value, &(kinfo->si_value));
+    /* SIMPLE_MAP_SIGINFO copies the kernel's signal number, which is
+     * Linux's; the handler was called with picolibc's. */
+    info.si_signo = sig;
     (*func.sa_sigaction)(sig, &info, ucontext);
 }
 
