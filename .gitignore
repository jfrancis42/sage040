# Build artifacts
*.elf
*.bin
*.o

# Programs built from the .c beside them. They have no extension on
# purpose -- exec.c decides what is executable from a file's first four
# bytes, not from its name -- so they cannot be caught by one. system/df
# and system/id had been committed by accident and were being carried as
# stale binaries in a public repository.
/system/df
/system/id

# Everything the test suites write: disk images, logs, fifos. One
# directory rather than scattered through the tree, removed by
# `make clean`. hd.img at the top level is deliberately NOT here -- it
# is the machine's disk, not a build product, and it is ignored below.
# scratch/ moved to /tmp/scratch (it was churning Dropbox); kept
# here so an old tree with one still ignores it.
/scratch/

# Emulator output captured during test runs
*.out
*.mon
*.tmp
*.usart
*.usartin
*.ppm

# Disk image created on demand by the test Makefile
disk.img

# Serial capture from boot/run.sh
boot/out.txt

# The machine's hard disk, in the project root (see disk.mk)
hd.img

# Flattened images written onto it
bootrom/payload.bin
kernel/kernel.rom
kernel/kernel.map

# Built programs. They have no extension on purpose -- the kernel decides
# what is executable by reading the file, not its name -- so they have to
# be named here one by one rather than matched by a suffix.
apps/cube
apps/hello
apps/fbtest
apps/faulter
apps/spin
apps/fetch
apps/httpd
system/ifconfig
system/ping
system/netstat
system/shutdown
system/env
system/sh
apps/napper
apps/cdtest
apps/statfs
apps/memtest
apps/malloctest
apps/sigtest
apps/fptest
apps/polltest
apps/timetest
apps/pipetest
apps/proctest
apps/socktest

# Scratch disk and log from kernel/fstest.sh
apps/vtcheck
system/stty
system/resize
apps/winsize
libc/test/libctest
libc/test/libctest.dyn
libc/test/sotest
libc/test/*.so
ldso/ld.so
system/fsck
ports/uemacs/em
apps/vcsnap
ports/vi/vi
system/host
system/ntpdate
apps/tcptest
apps/pagetest
system/swapon
system/swapoff
apps/limits
system/irqs
apps/fsstress
system/nvram
libc/test/inettest
libc/test/posixtest
libc/test/cryptest
libc/test/cryptest.c
apps/fbmap
apps/udpwait
ports/awk/awk
ports/sed/sed
ports/grep/grep
ports/sbase/bin/
ports/sbase/share/
ports/bash/bash
libc/test/threadtest
system/klogd
system/dmesg
libc/test/ptytest
system/reboot
system/which

# auth/: the privileged programs. Committed by accident when the
# directory was made -- six m68k binaries carried in a public
# repository, which is the same mistake /system/df and /system/id are
# named above for. A set-user-id program is the worst one to ship a
# stale build of.
auth/login
auth/su
auth/sudo
auth/passwd
auth/useradd
auth/userdel

# Core dumps. qemu-m68k's user-mode emulation drops them in the
# working directory when a program it is running faults, which is
# exactly what happens while porting something -- and they are ten
# megabytes each. Three of them reached a public repository once.
*.core
core
core.*

# DROPBOX CONFLICTED COPIES. This tree lives in Dropbox and is built on
# more than one machine; when two of them write hd.img, Dropbox keeps
# both and names the loser "hd (mother's conflicted copy DATE).img".
# A `git add -A` then sweeps in a 512 MB file, and GitHub refuses the
# whole push with "exceeds GitHub's file size limit of 100.00 MB" --
# which is how this rule came to exist.
*conflicted copy*
