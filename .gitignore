# Build artifacts
*.elf
*.bin
*.o

# Emulator output captured during test runs
*.out
*.mon
*.tmp
*.usart
*.usartin
*.ppm

# Disk image created on demand by the test Makefile
disk.img

# Serial capture from boot/run.sh
boot/out.txt

# The machine's hard disk, in the project root (see disk.mk)
hd.img

# Flattened images written onto it
bootrom/payload.bin
kernel/kernel.rom
kernel/kernel.map

# Built programs. They have no extension on purpose -- the kernel decides
# what is executable by reading the file, not its name -- so they have to
# be named here one by one rather than matched by a suffix.
user/cube
user/hello
user/fbtest
user/shutdown
user/faulter
user/spin

# Scratch disk and log from kernel/fstest.sh
kernel/hd-test.img
kernel/fstest.log
kernel/hd-edit.img
kernel/edittest.log
kernel/hd-vm.img
kernel/vmtest.log
