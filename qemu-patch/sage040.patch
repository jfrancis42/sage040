+/*
+ * The MC68040's unimplemented floating-point instructions, for
+ * fpsp-trap=on (cpu.h).
+ *
+ * The 68040 has only part of the MC68881/MC68882 instruction set in
+ * silicon; Table 9-10 of the MC68040 User's Manual lists the rest --
+ * FSIN, FETOX, FLOGN and so on. For one of those the chip fetches the
+ * source operand, converts it to extended precision, and takes vector
+ * 11 with a format $2 frame whose PC is the NEXT instruction (section
+ * 9.6.1). The handler, normally Motorola's M68040FPSP, then executes
+ * FSAVE and finds the instruction in a 26-word "unimplemented
+ * instruction" state frame: CMDREG1B, and both operands with tags
+ * (Table 9-16).
+ *
+ * The frame's layout is the FPSP's own (fpsp.h gives every field as an
+ * offset from the end of the frame), which is the software written
+ * against the real chip. Where it and Table 9-16 disagree -- the table
+ * says E1 is "always 1" for this frame, while the E1 definition and the
+ * FPSP's get_op both read E1 set as "the source is packed decimal" --
+ * the FPSP is followed: E1 clear, and the U flag set, as the FPSP's own
+ * FMOVECR path builds the frame by hand.
+ *
+ * Not modelled: the frame's address field (always 0 here; the FPSP
+ * reads it only for instructions that write memory, which none of
+ * these do); single- and double-precision denormal sources (tag 101 on
+ * the chip; converted already by the time they reach this helper, so
+ * tagged by what they became); and the busy frames of the E3
+ * exceptions (overflow, underflow, inexact), described below.
+ */
+
+#define M68040_UNIMP_FRAME  0x30    /* bytes after the header        */
+#define M68040_VERSION      0x41
+
+static uint8_t m68040_tag(floatx80 f)
+{
+    uint16_t exp = f.high & 0x7fff;
+
+    if (exp == 0x7fff) {
+        return (f.low << 1) ? 3 : 2;        /* NaN : infinity        */
+    }
+    if (exp == 0) {
+        return f.low ? 4 : 1;               /* denormal : zero       */
+    }
+    return (f.low >> 63) ? 0 : 4;           /* normal : unnormal     */
+}
+
+void HELPER(fpu_unimp)(CPUM68KState *env, FPReg *src, FPReg *dst,
+                       uint32_t ext)
+{
+    env->fpu_unimp.pending = true;
+    env->fpu_unimp.frame2 = true;
+    env->fpu_unimp.cmd = ext;
+    env->fpu_unimp.etemp = src->d;
+    env->fpu_unimp.fptemp = dst->d;
+    env->fpu_unimp.stag = m68040_tag(src->d);
+    env->fpu_unimp.dtag = m68040_tag(dst->d);
+}
+
+#define M68040_BUSY_FRAME   0x60    /* bytes after the header        */
+
+/*
+ * The fields of a posted exception, as offsets back from the END of the
+ * frame -- which is how the FPSP's fpsp.h names them, and the only way
+ * that serves both sizes: the FPSP grows a 26-word frame into a busy one
+ * by pushing words on the FRONT (x_snan.s, "expanding the unimp frame
+ * into a busy frame"), and every field stays where it was, counted from
+ * the end.
+ */
+#define FEND_STAG       0x28
+#define FEND_CMDREG1B   0x24
+#define FEND_DTAG       0x20
+#define FEND_E_BYTE     0x1c    /* E1 = 0x04                          */
+#define FEND_FPTEMP     0x18
+#define FEND_ETEMP      0x0c
+
+/*
+ * Floating-point arithmetic exceptions, for fpsp-trap=on.
+ *
+ * An enabled exception on the 68040 is POSTED: the destination is left
+ * as it was, the unit keeps the operands, and the next floating-point
+ * instruction takes it as a pre-instruction exception -- a format $0
+ * frame whose PC is that instruction (MC68040 User's Manual 9.7). The
+ * FPSP's handler finds the operands in the frame FSAVE writes.
+ *
+ * Modelled: SNAN, OPERR and divide by zero, the E1 exceptions -- found
+ * by the conversion unit, with the operands as their only state (Table
+ * 9-16), which is all this model has. Not modelled: overflow, underflow
+ * and inexact from FADD, FSUB, FMUL, FDIV and FSQRT, which are E3: their
+ * frame holds the intermediate result before final rounding, with its
+ * exponent unbounded and its guard, round and sticky bits, and softfloat
+ * produces only the rounded answer. Faking those fields would make the
+ * FPSP compute a wrong result, which is worse than not trapping.
+ * QEMU's own FPSR keeps only the accrued byte; the exception byte bits
+ * for these three are set here when one happens.
+ */
+#define FPCR_EN_SNAN    0x4000
+#define FPCR_EN_OPERR   0x2000
+#define FPCR_EN_DZ      0x0400
+#define FPCR_EN_BSUN    0x8000
+
+static bool m68040_snan(floatx80 f)
+{
+    return (f.high & 0x7fff) == 0x7fff && !(f.low & (1ULL << 62)) &&
+           (f.low & ((1ULL << 62) - 1));
+}
+
+/* Operations with two operands, whose destination is an input too. */
+static bool m68040_dyadic(int opmode)
+{
+    int op = opmode & 0x3f;
+
+    return (op >= 0x20 && op <= 0x28) || op == 0x38;
+}
+
+void HELPER(fpx_check)(CPUM68KState *env)
+{
+    if (env->fpu_exc.vector) {
+        CPUState *cs = env_cpu(env);
+
+        /* Taken before this instruction does anything; the unit keeps
+         * the exceptional state for the handler's FSAVE. */
+        cs->exception_index = env->fpu_exc.vector;
+        cpu_loop_exit_restore(cs, GETPC());
+    }
+}
+
+/*
+ * Before the source operand is fetched: its conversion to extended
+ * precision is part of the instruction, and a signalling NaN in memory
+ * is what raises "invalid" there -- softfloat quiets it as it converts,
+ * so the flag is the only record that it was ever signalling.
+ */
+void HELPER(fpx_begin)(CPUM68KState *env)
+{
+    /* The exception byte is this instruction's, as on the chip; the
+     * accrued byte below it is not touched. */
+    env->fpsr &= ~0xff00;
+    env->fpu_exc.armed = false;
+    if (!(env->fpcr & (FPCR_EN_SNAN | FPCR_EN_OPERR | FPCR_EN_DZ))) {
+        return;
+    }
+    env->fpu_exc.armed = true;
+    env->fpu_exc.saved_flags = get_float_exception_flags(&env->fp_status);
+    set_float_exception_flags(0, &env->fp_status);
+}
+
+/* After the fetch, before the operation. */
+void HELPER(fpx_pre)(CPUM68KState *env, FPReg *src, FPReg *dst, uint32_t ext)
+{
+    if (!env->fpu_exc.armed) {
+        return;
+    }
+    env->fpu_exc.saved = *dst;
+    env->fpu_exc.cmd = ext;
+    env->fpu_exc.etemp = src->d;
+    env->fpu_exc.fptemp = dst->d;
+    env->fpu_exc.src_snan =
+        (get_float_exception_flags(&env->fp_status) & float_flag_invalid) ||
+        m68040_snan(src->d);
+    if (env->fpu_exc.src_snan && (env->fpu_exc.etemp.high & 0x7fff) == 0x7fff) {
+        /* ETEMP holds it as the chip does: still signalling. */
+        env->fpu_exc.etemp.low &= ~(1ULL << 62);
+        if (!(env->fpu_exc.etemp.low & ((1ULL << 62) - 1))) {
+            env->fpu_exc.etemp.low |= 1;
+        }
+    }
+}
+
+void HELPER(fpx_post)(CPUM68KState *env, FPReg *dst)
+{
+    int flags, vec = 0;
+    uint32_t bit = 0, en = 0;
+    int opmode = env->fpu_exc.cmd & 0x7f;
+
+    if (!env->fpu_exc.armed) {
+        return;
+    }
+    env->fpu_exc.armed = false;
+    flags = get_float_exception_flags(&env->fp_status);
+    set_float_exception_flags(flags | env->fpu_exc.saved_flags,
+                              &env->fp_status);
+
+    if (flags & float_flag_invalid) {
+        if (env->fpu_exc.src_snan ||
+            (m68040_dyadic(opmode) && m68040_snan(env->fpu_exc.fptemp))) {
+            vec = 54, bit = 0x4000, en = FPCR_EN_SNAN;
+        } else {
+            vec = 52, bit = 0x2000, en = FPCR_EN_OPERR;
+        }
+    } else if (flags & float_flag_divbyzero) {
+        vec = 50, bit = 0x0400, en = FPCR_EN_DZ;
+    }
+    if (!vec) {
+        return;
+    }
+    env->fpsr |= bit;                   /* the exception byte */
+    if (!(env->fpcr & en)) {
+        return;
+    }
+    /* Posted: the destination as it was, the operands kept. */
+    *dst = env->fpu_exc.saved;
+    env->fpu_exc.vector = vec;
+    env->fpu_exc.stag = m68040_tag(env->fpu_exc.etemp);
+    env->fpu_exc.dtag = m68040_tag(env->fpu_exc.fptemp);
+}
+
+/*
+ * BSUN: an IEEE-nonaware conditional (predicates $10-$1F) tested with
+ * the NaN condition code set. With BSUN enabled it is taken at once, a
+ * pre-instruction exception on the conditional itself. The FPSP's
+ * fpsp_bsun reads nothing from the state frame, so none is posted.
+ */
+void HELPER(fpx_bsun)(CPUM68KState *env, uint32_t cond)
+{
+    if (!(cond & 0x10) || !(env->fpsr & FPSR_CC_A)) {
+        return;
+    }
+    env->fpsr |= 0x8000;                /* BSUN in the exception byte */
+    /* Accrued IOP: the accrued byte is kept in softfloat's flags. */
+    set_float_exception_flags(get_float_exception_flags(&env->fp_status) |
+                              float_flag_invalid, &env->fp_status);
+    if (env->fpcr & FPCR_EN_BSUN) {
+        CPUState *cs = env_cpu(env);
+
+        cs->exception_index = 48;
+        cpu_loop_exit_restore(cs, GETPC());
+    }
+}
+
+static uint32_t m68040_fsave_size(CPUM68KState *env)
+{
+    return env->fpu_exc.vector || env->fpu_unimp.pending
+           ? 4 + M68040_UNIMP_FRAME : 4;
+}
+
+static void m68040_st_ext(CPUM68KState *env, uint32_t addr, floatx80 v,
+                          uintptr_t ra)
+{
+    cpu_stl_be_data_ra(env, addr, (uint32_t)v.high << 16, ra);
+    cpu_stq_be_data_ra(env, addr + 4, v.low, ra);
+}
+
+/*
+ * An IDLE frame (header only) when nothing is pending, which is all
+ * this model ever wrote before; otherwise the unimplemented instruction
+ * frame. Offsets are from the header; fpsp.h has the same fields as
+ * offsets from the end, 0x34 bytes on.
+ */
+/*
+ * A posted E1 exception (SNAN, OPERR, DZ) saves the 26-word frame the
+ * unimplemented instruction does, with E1 set and T and U clear: the
+ * frame the FPSP's handlers expect, since x_snan.s turns it into a busy
+ * frame itself before handing it on (Table 9-16 lists the same fields
+ * for both).
+ */
+static void m68040_fsave_exc(CPUM68KState *env, uint32_t addr,
+                             uintptr_t ra)
+{
+    uint32_t end = addr + 4 + M68040_UNIMP_FRAME;
+    int i;
+
+    cpu_stl_be_data_ra(env, addr,
+                       (M68040_VERSION << 24) | (M68040_UNIMP_FRAME << 16),
+                       ra);
+    for (i = 4; i < 4 + M68040_UNIMP_FRAME; i += 4) {
+        cpu_stl_be_data_ra(env, addr + i, 0, ra);
+    }
+    cpu_stb_data_ra(env, end - FEND_STAG, env->fpu_exc.stag << 5, ra);
+    cpu_stw_be_data_ra(env, end - FEND_CMDREG1B, env->fpu_exc.cmd, ra);
+    cpu_stb_data_ra(env, end - FEND_DTAG, env->fpu_exc.dtag << 5, ra);
+    cpu_stb_data_ra(env, end - FEND_E_BYTE, 0x04, ra);  /* E1 */
+    m68040_st_ext(env, end - FEND_FPTEMP, env->fpu_exc.fptemp, ra);
+    m68040_st_ext(env, end - FEND_ETEMP, env->fpu_exc.etemp, ra);
+    env->fpu_exc.vector = 0;
+}
+
+static void m68040_fsave(CPUM68KState *env, uint32_t addr, uintptr_t ra)
+{
+    int i;
+
+    if (env->fpu_exc.vector) {
+        m68040_fsave_exc(env, addr, ra);
+        return;
+    }
+    if (!env->fpu_unimp.pending) {
+        cpu_stl_be_data_ra(env, addr, M68040_VERSION << 24, ra);
+        return;
+    }
+    cpu_stl_be_data_ra(env, addr,
+                       (M68040_VERSION << 24) | (M68040_UNIMP_FRAME << 16),
+                       ra);
+    for (i = 4; i < 4 + M68040_UNIMP_FRAME; i += 4) {
+        cpu_stl_be_data_ra(env, addr + i, 0, ra);
+    }
+    cpu_stb_data_ra(env, addr + 0x0c, env->fpu_unimp.stag << 5, ra);
+    cpu_stw_be_data_ra(env, addr + 0x10, env->fpu_unimp.cmd, ra);
+    cpu_stb_data_ra(env, addr + 0x14, env->fpu_unimp.dtag << 5, ra);
+    cpu_stb_data_ra(env, addr + 0x19, 0x20, ra);        /* U flag */
+    m68040_st_ext(env, addr + 0x1c, env->fpu_unimp.fptemp, ra);
+    m68040_st_ext(env, addr + 0x28, env->fpu_unimp.etemp, ra);
+    /* The FSAVE takes the state out of the unit, which is left idle. */
+    env->fpu_unimp.pending = false;
+}
+
+void HELPER(fsave)(CPUM68KState *env, uint32_t addr)
+{
+    m68040_fsave(env, addr, GETPC());
+}
+
+void HELPER(fsave_predec)(CPUM68KState *env, uint32_t reg)
+{
+    uint32_t addr = env->aregs[reg] - m68040_fsave_size(env);
+
+    m68040_fsave(env, addr, GETPC());
+    env->aregs[reg] = addr;
+}
+
+/*
+ * FRESTORE: whatever the frame, its size is in the header, and a
+ * postincrement has to step over all of it -- the FPSP restores frames
+ * of 4, 0x2c, 0x34 and 0x64 bytes. The state itself is not reloaded:
+ * this model has none to reload into but the pending unimplemented
+ * instruction, which a restore ends.
+ */
+static floatx80 m68040_ld_ext(CPUM68KState *env, uint32_t addr,
+                              uintptr_t ra)
+{
+    floatx80 v;
+
+    v.high = cpu_ldl_be_data_ra(env, addr, ra) >> 16;
+    v.low = cpu_ldq_be_data_ra(env, addr + 4, ra);
+    return v;
+}
+
+static uint32_t m68040_frestore(CPUM68KState *env, uint32_t addr,
+                                uintptr_t ra)
+{
+    uint32_t hdr = cpu_ldl_be_data_ra(env, addr, ra);
+    uint32_t size = (hdr >> 16) & 0xff;
+
+    env->fpu_unimp.pending = false;
+    env->fpu_exc.vector = 0;
+    /*
+     * A frame with E1 still set is an exception still pending: the next
+     * floating-point instruction reports it, as it would have if the
+     * frame had never left the unit. With E1 clear -- the FPSP's real_*
+     * handlers clear it before restoring -- it is finished. Either size:
+     * the FPSP restores the 26-word frame it was given, or the busy
+     * frame it grew from it.
+     *
+     * Which exception is the FPSR's to say: its exception byte, masked
+     * by the FPCR's enables, in the chip's priority. The frame has no
+     * field for it (every byte of it is one the FPSP uses), and both the
+     * FPSP and a task switch restore the control registers BEFORE the
+     * frame, as the manual requires.
+     */
+    if (size == M68040_UNIMP_FRAME || size == M68040_BUSY_FRAME) {
+        uint32_t end = addr + 4 + size;
+        uint32_t live = env->fpsr & env->fpcr;
+        int vec = live & FPCR_EN_SNAN ? 54 :
+                  live & FPCR_EN_OPERR ? 52 :
+                  live & FPCR_EN_DZ ? 50 : 0;
+
+        if ((cpu_ldub_data_ra(env, end - FEND_E_BYTE, ra) & 0x04) && vec) {
+            env->fpu_exc.vector = vec;
+            env->fpu_exc.stag = cpu_ldub_data_ra(env, end - FEND_STAG, ra) >> 5;
+            env->fpu_exc.cmd = cpu_lduw_be_data_ra(env, end - FEND_CMDREG1B, ra);
+            env->fpu_exc.dtag = cpu_ldub_data_ra(env, end - FEND_DTAG, ra) >> 5;
+            env->fpu_exc.fptemp = m68040_ld_ext(env, end - FEND_FPTEMP, ra);
+            env->fpu_exc.etemp = m68040_ld_ext(env, end - FEND_ETEMP, ra);
+        }
+    }
+    return 4 + size;
+}
+
+void HELPER(frestore)(CPUM68KState *env, uint32_t addr)
+{
+    m68040_frestore(env, addr, GETPC());
+}
+
+void HELPER(frestore_postinc)(CPUM68KState *env, uint32_t reg)
+{
+    uint32_t addr = env->aregs[reg];
+
+    env->aregs[reg] = addr + m68040_frestore(env, addr, GETPC());
+}
