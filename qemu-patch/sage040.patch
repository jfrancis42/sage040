+    case 0x0d: case 0x0e: case 0x0f: case 0x10:     /* ftanh fatan fasin */
+    case 0x11: case 0x12: case 0x14: case 0x15:     /* fatanh fsin ftan  */
+    case 0x16: case 0x19: case 0x1c: case 0x1d:     /* fetox ftwotox ... */
+    case 0x1e: case 0x1f:                           /* fgetexp fgetman   */
+    case 0x21: case 0x25: case 0x26:                /* fmod frem fscale  */
