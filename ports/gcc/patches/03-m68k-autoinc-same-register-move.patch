 {
+  const char *split;
+
   handle_flags_for_move (operands);
+  if ((split = m68k_output_move_autoinc_conflict (operands)) != NULL)
+    return split;
 
   if (GET_CODE (operands[1]) == CONST_INT)
     return output_move_simode_const (operands);
