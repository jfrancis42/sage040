+/* A memory-to-memory move whose SOURCE address auto-modifies a register
+   that the DESTINATION address also uses, such as
+
+	move.b (%a0)+,(0,%a0,%d1.l)
+
+   In RTL every use of %a0 in the insn sees its value before the
+   increment, and passes that substitute one address into another
+   (late-combine does) are entitled to make such an insn.  The 68000
+   family does not execute it that way: it finishes the source operand,
+   post-increment or pre-decrement included, before it calculates the
+   destination address, so the destination is off by the size of the
+   move.  Emit it as the plain move, with the source's register
+   unmodified, followed by the adjustment -- addq/subq to an address
+   register leaves the condition codes alone, so the move's flags stand.
+   Returns "" having output both, or NULL when OPERANDS need nothing.  */
+
+const char *
+m68k_output_move_autoinc_conflict (rtx *operands)
+{
+  rtx dst = operands[0], src = operands[1], addr, reg, xops[4];
+  HOST_WIDE_INT n;
+  enum rtx_code code;
+
+  if (!MEM_P (src) || !MEM_P (dst))
+    return NULL;
+  addr = XEXP (src, 0);
+  code = GET_CODE (addr);
+  if (code != POST_INC && code != PRE_DEC)
+    return NULL;
+  reg = XEXP (addr, 0);
+  if (!reg_mentioned_p (reg, XEXP (dst, 0)))
+    return NULL;
+
+  n = GET_MODE_SIZE (GET_MODE (src));
+  /* A byte push or pop moves the stack pointer by two.  */
+  if (n == 1 && REGNO (reg) == STACK_POINTER_REGNUM)
+    n = 2;
+  gcc_assert (n >= 1 && n <= 8);
+
+  /* What the flags describe is no longer a location either operand
+     names once the register has moved.  */
+  flags_operand1 = flags_operand2 = NULL_RTX;
+
+  xops[0] = dst;
+  xops[1] = replace_equiv_address_nv (src, code == POST_INC
+					   ? reg
+					   : plus_constant (Pmode, reg, -n));
+  xops[2] = reg;
+  xops[3] = GEN_INT (n);
+  switch (GET_MODE_SIZE (GET_MODE (src)))
+    {
+    case 1: output_asm_insn ("move%.b %1,%0", xops); break;
+    case 2: output_asm_insn ("move%.w %1,%0", xops); break;
+    case 4: output_asm_insn ("move%.l %1,%0", xops); break;
+    default: gcc_unreachable ();
+    }
+  output_asm_insn (code == POST_INC ? "addq%.l %3,%2" : "subq%.l %3,%2",
+		   xops);
+  return "";
+}
+
